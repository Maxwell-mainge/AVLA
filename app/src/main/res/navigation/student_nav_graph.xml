<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studentNavGraphRoot"
    app:startDestination="@id/homeFragment">

    <!-- Pure flat destination blocks without internal actions to keep layouts light -->
    <fragment android:id="@+id/homeFragment"
        android:name="com.avla.app.ui.listings.HomeFragment"
        android:label="Home" />

    <fragment android:id="@+id/searchFragment"
        android:name="com.avla.app.ui.listings.SearchFragment"
        android:label="Search" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.avla.app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment android:id="@+id/listingDetailFragment"
        android:name="com.avla.app.ui.listings.ListingDetailFragment"
        android:label="Listing Details" />

    <fragment android:id="@+id/favoritesFragment"
        android:name="com.avla.app.ui.listings.FavoritesFragment"
        android:label="Favorites" />

    <fragment android:id="@+id/aboutFragment"
        android:name="com.avla.app.ui.profile.AboutFragment"
        android:label="About AVLA" />

</navigation>