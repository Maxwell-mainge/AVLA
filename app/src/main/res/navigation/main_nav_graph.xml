<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainNavGraphRoot"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.avla.app.ui.listings.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.avla.app.ui.listings.SearchFragment"
        android:label="Search" />

    <fragment
        android:id="@+id/postListingFragment"
        android:name="com.avla.app.ui.listings.PostListingFragment"
        android:label="Post Listing" />

    <fragment
        android:id="@+id/myListingsFragment"
        android:name="com.avla.app.ui.listings.MyListingsFragment"
        android:label="My Listings">

        <action
            android:id="@+id/action_myListingsFragment_to_landlordManageListingFragment"
            app:destination="@id/landlordManageListingFragment" />

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.avla.app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/listingDetailFragment"
        android:name="com.avla.app.ui.listings.ListingDetailFragment"
        android:label="Listing Details" />

    <fragment
        android:id="@+id/landlordManageListingFragment"
        android:name="com.avla.app.ui.listings.LandlordManageListingFragment"
        android:label="Manage Listing" />

</navigation>