<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AVLA" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- System Window Palette Overrides -->
        <item name="colorPrimary">@color/avla_green</item>
        <item name="colorPrimaryDark">@color/avla_green</item>
        <item name="colorPrimaryVariant">@color/avla_green_dark</item>
        <item name="colorSecondary">@color/avla_green_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar Controls -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>

        <!-- Force all text to be dark on white background -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/grey_text</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:editTextBackground">@android:color/transparent</item>

        <!-- Gives every plain EditText created in code (e.g. inside AlertDialogs
             for change-password, suspend reason, forgot-password email, etc.)
             a visible bordered look app-wide, without touching each fragment. -->
        <item name="android:editTextStyle">@style/AVLA.DialogEditText</item>

        <!-- Makes every AlertDialog.Builder (not just MaterialAlertDialogBuilder)
             render with Material's rounded corners and colorPrimary-tinted
             buttons app-wide, since AppCompat's AlertDialog respects this
             theme attribute. -->
        <item name="alertDialogTheme">@style/AVLA.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/AVLA.AlertDialog</item>

        <!-- TextInputLayout outlined box colors -->
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_input_hint</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.AVLA.TextInputLayout</item>

        <!-- Global Bottom Navigation Override -->
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView</item>
    </style>


    <!-- Overlay that forces OutlinedBox fields to always show border + label -->
    <style name="ThemeOverlay.AVLA.TextInputLayout" parent="">
        <item name="colorOnSurface">@color/black</item>
        <item name="colorPrimary">@color/avla_green</item>
    </style>

    <style name="Theme.AVLA.Splash" parent="Theme.AVLA" />

    <!-- Shared OutlinedBox style applied to all TextInputLayouts -->
    <style name="AVLA.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/text_input_hint</item>
        <item name="android:textColorHint">@color/grey_text</item>
    </style>

    <style name="AVLA.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BottomNavText">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         Dialog polish — applied app-wide via Theme.AVLA above,
         so every AlertDialog.Builder(...) in the app picks these
         up automatically. No per-fragment changes needed.
         ═══════════════════════════════════════════════════════ -->

    <style name="AVLA.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/AVLA.AlertDialog.ShapeOverlay</item>
        <item name="buttonBarPositiveButtonStyle">@style/AVLA.AlertDialog.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AVLA.AlertDialog.NegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AVLA.AlertDialog.NeutralButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AVLA.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AVLA.AlertDialog.Body</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>

    <style name="AVLA.AlertDialog.ShapeOverlay" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Filled green button — matches the app's main action buttons elsewhere -->
    <style name="AVLA.AlertDialog.PositiveButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/avla_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Outlined grey button for Cancel/dismiss -->
    <style name="AVLA.AlertDialog.NegativeButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/text_input_stroke_color</item>
        <item name="android:textColor">@color/grey_text</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Neutral button (e.g. "Open Property Doc") — plain text, less emphasis -->
    <style name="AVLA.AlertDialog.NeutralButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/avla_green</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AVLA.AlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="AVLA.AlertDialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/grey_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Bordered look for plain EditText(context) instances built in code
         (change password fields, suspend reason, forgot-password email, etc.) -->
    <style name="AVLA.DialogEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_dialog_edittext</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/grey_text</item>
    </style>

</resources>