<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- 🛠️ CHANGED: Swapped standard email icon to a generic information/alert icon suitable for review -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="Review status icon" />

    <!-- 🛠️ ADDED: android:id="@+id/tvTitle" so Kotlin can update it -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Account Created"
        android:textColor="@color/avla_green"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 🛠️ ADDED: android:id="@+id/tvMessage" so Kotlin can update it -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Your account setup is successful. Please wait for an administrator to verify your uploaded property documents before logging in."
        android:textColor="@color/grey_text"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/avla_green"
        android:text="Refresh Approval Status"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sign Out / Back to Login"
        android:textColor="@color/avla_green" />

</LinearLayout>
