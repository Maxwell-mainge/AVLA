<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView android:id="@+id/ivIcon"
        android:layout_width="80dp" android:layout_height="80dp"
        android:src="@android:drawable/ic_dialog_alert" android:contentDescription="ID flagged icon"/>

    <TextView android:id="@+id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center"
        android:text="Your school ID needs a resubmit"
        android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold"/>

    <TextView android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center"
        android:text="An admin reviewed your school ID and it couldn't be verified. You can still use AVLA once you resubmit a valid document link."
        android:textColor="@color/grey_text" android:textSize="14sp"/>

    <TextView android:id="@+id/tvReason" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:gravity="center" android:textColor="#D32F2F" android:textSize="14sp"/>

    <!-- Resubmit form — hidden once the student has submitted and is awaiting admin recheck -->
    <LinearLayout
        android:id="@+id/llResubmitForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:boxStrokeColor="@color/avla_green"
            style="@style/AVLA.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStudentIdLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New school ID document link"
                android:inputType="textUri"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDrive"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconTint="@color/avla_green"
            android:text="Open Google Drive"
            android:textColor="@color/avla_green"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:strokeColor="@color/avla_green"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnResubmit"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:backgroundTint="@color/avla_green"
            android:text="Resubmit ID" android:textColor="@color/white"/>

    </LinearLayout>

    <!-- Shown instead of the form once resubmitted, while awaiting admin recheck -->
    <TextView
        android:id="@+id/tvUnderReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Your resubmitted document is under review. You'll be able to use AVLA normally once an admin approves it. Check back by logging out and back in."
        android:textColor="@color/grey_text"
        android:textSize="14sp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Logout"/>

</LinearLayout>